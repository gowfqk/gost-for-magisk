#!/system/bin/sh
#
# api - CGI script for Gost WebUI API
# Executed by busybox httpd for /cgi-bin/api requests
#

# ---- Determine MODDIR from script path ----
SCRIPT_PATH="$0"
CGI_DIR=$(dirname "$SCRIPT_PATH" 2>/dev/null)
WEBUI_DIR=$(dirname "$CGI_DIR" 2>/dev/null)
MODDIR=$(dirname "$WEBUI_DIR" 2>/dev/null)

if [ ! -d "$MODDIR/gost" ]; then
    MODDIR="/data/adb/modules/gost_proxy"
fi

CONFIG="$MODDIR/gost/config.json"
NODES_DIR="$MODDIR/gost/nodes"
ACTIVE_FILE="$MODDIR/gost/active"
LOG_PATH="$MODDIR/logs/gost.log"
PIDFILE="/tmp/gost.pid"
PERSIST_BIN="/data/adb/gost_proxy/gost"

mkdir -p "$NODES_DIR"

usable_gost_binary() {
    _bin="$1"
    [ -s "$_bin" ] && ! grep -q "Placeholder" "$_bin" 2>/dev/null
}

atomic_copy() {
    _src="$1" _dst="$2" _dir=${2%/*}
    _tmp="$_dir/.gost.tmp.$$"
    mkdir -p "$_dir" || return 1
    cp "$_src" "$_tmp" || { rm -f "$_tmp"; return 1; }
    chmod 755 "$_tmp" 2>/dev/null
    mv -f "$_tmp" "$_dst" || { rm -f "$_tmp"; return 1; }
}

# A root manager may replace the module directory while the persistent copy is
# still intact. Restore it lazily so WebUI status and start actions agree.
ensure_gost_binary() {
    if usable_gost_binary "$MODDIR/gost/gost"; then
        # Heal missing/stale persistence for manually installed and legacy bins.
        atomic_copy "$MODDIR/gost/gost" "$PERSIST_BIN" 2>/dev/null || true
        return 0
    fi
    if usable_gost_binary "$PERSIST_BIN"; then
        atomic_copy "$PERSIST_BIN" "$MODDIR/gost/gost" || return 1
        return 0
    fi
    return 1
}

# ---- Parse query string ----
url_decode() {
    printf '%s' "$1" | awk '
        BEGIN { hex = "0123456789abcdef" }
        {
            value = $0
            gsub(/\+/, " ", value)
            out = ""
            for (i = 1; i <= length(value); i++) {
                ch = substr(value, i, 1)
                if (ch == "%" && i + 2 <= length(value)) {
                    pair = tolower(substr(value, i + 1, 2))
                    hi = index(hex, substr(pair, 1, 1)) - 1
                    lo = index(hex, substr(pair, 2, 1)) - 1
                    if (hi >= 0 && lo >= 0) {
                        out = out sprintf("%c", hi * 16 + lo)
                        i += 2
                        continue
                    }
                }
                out = out ch
            }
            printf "%s", out
        }
    '
}

ENDPOINT=""
LINES="200"
QUERY_NAME=""
QUERY_ACTIVATE=""
_query_lines=$(printf '%s' "${QUERY_STRING:-}" | tr '&' '\n')
while IFS= read -r pair; do
    [ -n "$pair" ] || continue
    case "$pair" in
        *=*) key=${pair%%=*}; val=${pair#*=} ;;
        *)   key=$pair; val="" ;;
    esac
    key=$(url_decode "$key")
    val=$(url_decode "$val")
    case "$key" in
        endpoint) ENDPOINT="$val" ;;
        lines)    LINES="$val" ;;
        name)     QUERY_NAME="$val" ;;
        activate) QUERY_ACTIVATE="$val" ;;
    esac
done <<EOF
$_query_lines
EOF

# ---- Read POST body ----
BODY=""
MAX_BODY_SIZE=65536
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ]; then
    case "$CONTENT_LENGTH" in
        ''|*[!0-9]*) CONTENT_LENGTH=0 ;;
    esac
    if [ "$CONTENT_LENGTH" -gt "$MAX_BODY_SIZE" ] 2>/dev/null; then
        json_header() {
            printf 'Content-Type: application/json; charset=utf-8\r\n'
            printf 'Cache-Control: no-store\r\n\r\n'
        }
        json_header
        printf '{"success":false,"message":"Request body too large"}'
        exit 0
    elif [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
        BODY=$(dd bs=1 count="$CONTENT_LENGTH" 2>/dev/null)
    fi
fi

# ---- Helpers ----
json_header() {
    printf 'Content-Type: application/json; charset=utf-8\r\n'
    printf 'Cache-Control: no-store\r\n'
    printf '\r\n'
}

# Use .*":  to avoid truncating values containing colons (e.g. passwords)
jval() {
    grep -o "\"$1\"[[:space:]]*:[[:space:]]*[^,}]*" "$CONFIG" 2>/dev/null | head -1 | sed 's/.*":[[:space:]]*//' | tr -d '"'
}

jsection_val_from_file() {
    _file="$1" _section="$2" _key="$3"
    awk -v section="$_section" -v key="$_key" '
        function find_object(json, section,    pattern, rest, start, i, ch, escaped, quoted, depth) {
            pattern = "\\\"" section "\\\"[[:space:]]*:"
            if (!match(json, pattern)) return ""
            start = RSTART + RLENGTH
            rest = substr(json, start)
            if (!match(rest, /^[[:space:]]*\{/)) return ""
            start += RSTART + RLENGTH - 2
            depth = 0; quoted = 0; escaped = 0
            for (i = start; i <= length(json); i++) {
                ch = substr(json, i, 1)
                if (quoted) {
                    if (escaped) escaped = 0
                    else if (ch == "\\") escaped = 1
                    else if (ch == "\"") quoted = 0
                    continue
                }
                if (ch == "\"") quoted = 1
                else if (ch == "{") depth++
                else if (ch == "}" && --depth == 0) return substr(json, start, i - start + 1)
            }
            return ""
        }
        function get_scalar(object, key,    pattern, rest, i, ch, escaped, value) {
            pattern = "\\\"" key "\\\"[[:space:]]*:"
            if (!match(object, pattern)) return ""
            rest = substr(object, RSTART + RLENGTH)
            sub(/^[[:space:]]*/, "", rest)
            if (substr(rest, 1, 1) == "[") {
                if (match(rest, /^\[[^]]*\]/)) return substr(rest, 2, RLENGTH - 2)
                return ""
            }
            if (substr(rest, 1, 1) != "\"") {
                if (match(rest, /^[^,}]*/)) {
                    value = substr(rest, RSTART, RLENGTH)
                    sub(/[[:space:]]*$/, "", value)
                    return value
                }
                return ""
            }
            value = ""; escaped = 0
            for (i = 2; i <= length(rest); i++) {
                ch = substr(rest, i, 1)
                if (escaped) {
                    if (ch == "\"" || ch == "\\" || ch == "/") value = value ch
                    else if (ch == "n") value = value "\\n"
                    else if (ch == "r") value = value "\\r"
                    else if (ch == "t") value = value "\\t"
                    else value = value "\\" ch
                    escaped = 0
                } else if (ch == "\\") escaped = 1
                else if (ch == "\"") return value
                else value = value ch
            }
            return ""
        }
        { json = json $0 "\n" }
        END {
            object = find_object(json, section)
            if (object != "") print get_scalar(object, key)
        }
    ' "$_file" 2>/dev/null
}

jsection_val() {
    jsection_val_from_file "$CONFIG" "$1" "$2"
}

# Extract a field from a specific JSON file
jval_file() {
    _file="$1" _key="$2"
    grep -o "\"$_key\"[[:space:]]*:[[:space:]]*[^,}]*" "$_file" 2>/dev/null | head -1 | sed 's/.*":[[:space:]]*//' | tr -d '"'
}

jsection_val_file() {
    jsection_val_from_file "$1" "$2" "$3"
}

# Extract "name" from JSON body
extract_json_name() {
    echo "$BODY" | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*:[[:space:]]*"//' | tr -d '"'
}

extract_json_display_name() {
    echo "$BODY" | grep -o '"display_name"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*:[[:space:]]*"//' | tr -d '"'
}

json_escape_value() {
    printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{if (NR > 1) printf "\\n"; printf "%s", $0}'
}

# Node names become filenames. Keep them deliberately strict so a WebUI
# request cannot escape NODES_DIR or create ambiguous names.
valid_node_name() {
    _name="$1"
    [ -n "$_name" ] && [ ${#_name} -le 64 ] || return 1
    case "$_name" in
        *[!A-Za-z0-9._-]*|.*|*..*) return 1 ;;
    esac
    return 0
}

# Get active node name
get_active_node() {
    if [ -f "$ACTIVE_FILE" ]; then
        cat "$ACTIVE_FILE"
    else
        echo "default"
    fi
}

normalize_proxy_type() {
    case "$1" in
        ""|redirect|red|redir) printf '%s' redirect ;;
        socks|socks5) printf '%s' socks5 ;;
        *) printf '%s' "$1" ;;
    esac
}

normalize_config() {
    _data="$1"
    _proxy_type=$(printf '%s' "$_data" | grep -o '"proxy_type"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//')
    _proxy_type=$(normalize_proxy_type "$_proxy_type")
    if printf '%s' "$_data" | grep -q '"proxy_type"[[:space:]]*:'; then
        _sed_proxy_type=$(printf '%s' "$_proxy_type" | sed 's/[\\&|]/\\&/g')
        printf '%s' "$_data" | sed "s|\"proxy_type\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"proxy_type\": \"$_sed_proxy_type\"|"
    else
        printf '%s' "$_data" | sed '0,/{/s||{\n    "proxy_type": "redirect",|'
    fi
}

valid_config() {
    _data="$1"
    [ -n "$_data" ] && [ ${#_data} -le 65536 ] || return 1
    printf '%s' "$_data" | grep -q '^[[:space:]]*{' || return 1
    printf '%s' "$_data" | grep -q '}[[:space:]]*$' || return 1
    _proxy_type=$(printf '%s' "$_data" | grep -o '"proxy_type"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"//; s/"$//')
    case "$_proxy_type" in redirect|socks5) ;; *) return 1 ;; esac
    _listen_port=$(printf '%s' "$_data" | grep -o '"listen_port"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | grep -o '[0-9]*$')
    _webui_port=$(printf '%s' "$_data" | grep -o '"webui_port"[[:space:]]*:[[:space:]]*[0-9]*' | head -1 | grep -o '[0-9]*$')
    [ -n "$_listen_port" ] && [ "$_listen_port" -ge 1 ] 2>/dev/null && [ "$_listen_port" -le 65535 ] 2>/dev/null || return 1
    [ -z "$_webui_port" ] || { [ "$_webui_port" -ge 1 ] 2>/dev/null && [ "$_webui_port" -le 65535 ] 2>/dev/null; } || return 1
}

write_config() {
    _data="$1"
    # Older WebUI builds rebuilt config.json from visible form fields and omitted
    # node_name. Preserve the active node display name server-side so editing any
    # setting can never silently rename the node to its internal file ID.
    if ! printf '%s' "$_data" | grep -q '"node_name"[[:space:]]*:'; then
        _active=$(get_active_node)
        _active_file="$NODES_DIR/${_active}.json"
        _node_name=""
        [ -f "$_active_file" ] && _node_name=$(jval_file "$_active_file" node_name)
        [ -z "$_node_name" ] && [ -f "$CONFIG" ] && _node_name=$(jval_file "$CONFIG" node_name)
        if [ -n "$_node_name" ]; then
            _escaped_name=$(json_escape_value "$_node_name")
            _sed_name=$(printf '%s' "$_escaped_name" | sed 's/[\\&|]/\\&/g')
            _data=$(printf '%s' "$_data" | sed "0,/{/s||{\n    \"node_name\": \"$_sed_name\",|")
        fi
    fi
    _data=$(normalize_config "$_data")
    valid_config "$_data" || return 1
    _tmp="$CONFIG.tmp.$$"
    umask 077
    printf '%s' "$_data" > "$_tmp" || return 1
    mv -f "$_tmp" "$CONFIG" || { rm -f "$_tmp"; return 1; }
}

# Keep edits to config.json synchronized with the active saved node.
sync_active_node() {
    _active=$(get_active_node)
    if valid_node_name "$_active" && [ -f "$NODES_DIR/${_active}.json" ]; then
        cp "$CONFIG" "$NODES_DIR/${_active}.json"
    fi
}

# ---- Route by endpoint ----
case "$ENDPOINT" in
    status)
        GOST_STATUS="stopped"
        GOST_PID=""
        if [ -f "$PIDFILE" ]; then
            GOST_PID=$(cat "$PIDFILE" 2>/dev/null)
            if [ -n "$GOST_PID" ] && kill -0 "$GOST_PID" 2>/dev/null; then
                GOST_STATUS="running"
            else
                GOST_PID=""
            fi
        fi
        ARCH=$(getprop ro.product.cpu.abi 2>/dev/null || echo "unknown")
        LP=$(jval listen_port); [ -z "$LP" ] && LP="1080"
        PT=$(normalize_proxy_type "$(jval proxy_type)")
        case "$PT" in redirect|socks5) ;; *) PT="redirect" ;; esac
        LA=$(jval listen_addr); [ -z "$LA" ] && LA="0.0.0.0"
        WP=$(jval webui_port);  [ -z "$WP" ] && WP="8080"
        ACTIVE_NODE=$(get_active_node)
        GEODATA_EN=$(jsection_val geodata enabled)
        GEODATA_READY="false"
        [ -f "$MODDIR/gost/geodata/direct-rules.txt" ] && GEODATA_READY="true"
        GOST_BINARY_READY="false"
        if [ "$GOST_STATUS" = "running" ] || ensure_gost_binary; then
            GOST_BINARY_READY="true"
        fi
        GOST_DOWNLOADING="false"
        [ -d "/tmp/gost-download.lock" ] && GOST_DOWNLOADING="true"
        json_header
        printf '{"gost":{"status":"%s","pid":"%s","binary_ready":%s,"downloading":%s},"webui":{"status":"running","port":%s},"arch":"%s","listen_port":%s,"proxy_type":"%s","listen_addr":"%s","active_node":"%s","geodata_enabled":"%s","geodata_ready":"%s"}' \
            "$GOST_STATUS" "$GOST_PID" "$GOST_BINARY_READY" "$GOST_DOWNLOADING" "$WP" "$ARCH" "$LP" "$PT" "$LA" "$ACTIVE_NODE" "$GEODATA_EN" "$GEODATA_READY"
        ;;

    config)
        if [ "$REQUEST_METHOD" = "GET" ]; then
            if [ -f "$CONFIG" ]; then
                printf 'Content-Type: application/json; charset=utf-8\r\n\r\n'
                cat "$CONFIG"
            else
                json_header
                printf '{"error":"Config not found"}'
            fi
        elif [ "$REQUEST_METHOD" = "POST" ]; then
            if write_config "$BODY"; then
                sync_active_node
                json_header
                printf '{"success":true,"message":"Config saved"}'
            else
                json_header
                printf '{"success":false,"message":"Invalid config"}'
            fi
        fi
        ;;

    nodes)
        ACTIVE_NODE=$(get_active_node)
        # Build JSON array of nodes
        NODES_JSON="["
        _first=1
        if [ -d "$NODES_DIR" ] && [ -n "$(ls "$NODES_DIR"/*.json 2>/dev/null)" ]; then
            for _f in "$NODES_DIR"/*.json; do
                [ -f "$_f" ] || continue
                _name=$(basename "$_f" .json)
                _display_name=$(jval_file "$_f" node_name)
                [ -z "$_display_name" ] && _display_name="$_name"
                _display_name=$(json_escape_value "$_display_name")
                _ptype=$(normalize_proxy_type "$(jval_file "$_f" proxy_type)")
                case "$_ptype" in redirect|socks5) ;; *) _ptype="redirect" ;; esac
                _lport=$(jval_file "$_f" listen_port)
                [ -z "$_lport" ] && _lport="1080"
                _uaddr=$(jsection_val_file "$_f" upstream addr)
                _uport=$(jsection_val_file "$_f" upstream port)
                _utype=$(jsection_val_file "$_f" upstream type)
                _uenabled=$(jsection_val_file "$_f" upstream enabled)
                _is_active="false"
                [ "$_name" = "$ACTIVE_NODE" ] && _is_active="true"
                if [ $_first -eq 0 ]; then
                    NODES_JSON="${NODES_JSON},"
                fi
                NODES_JSON="${NODES_JSON}{\"id\":\"${_name}\",\"name\":\"${_display_name}\",\"display_name\":\"${_display_name}\",\"proxy_type\":\"${_ptype}\",\"listen_port\":${_lport},\"upstream\":{\"enabled\":\"${_uenabled}\",\"type\":\"${_utype}\",\"addr\":\"${_uaddr}\",\"port\":\"${_uport}\"},\"active\":${_is_active}}"
                _first=0
            done
        fi
        NODES_JSON="${NODES_JSON}]"
        json_header
        printf '{"nodes":%s,"active":"%s"}' "$NODES_JSON" "$ACTIVE_NODE"
        ;;

    nodes/import)
        NODE_NAME="$QUERY_NAME"
        if ! valid_node_name "$NODE_NAME"; then
            json_header
            printf '{"success":false,"message":"Invalid node name"}'
        elif [ -f "$NODES_DIR/${NODE_NAME}.json" ]; then
            json_header
            printf '{"success":false,"message":"Node already exists"}'
        else
            NODE_CONFIG=$(normalize_config "$BODY")
            if ! valid_config "$NODE_CONFIG"; then
                json_header
                printf '{"success":false,"message":"Invalid config"}'
            elif [ "$QUERY_ACTIVATE" = "false" ]; then
                umask 077
                printf '%s' "$NODE_CONFIG" > "$NODES_DIR/${NODE_NAME}.json"
                json_header
                printf '{"success":true,"message":"Node imported","name":"%s"}' "$NODE_NAME"
            elif write_config "$NODE_CONFIG"; then
                cp "$CONFIG" "$NODES_DIR/${NODE_NAME}.json" && echo "$NODE_NAME" > "$ACTIVE_FILE"
                json_header
                printf '{"success":true,"message":"Node imported","name":"%s"}' "$NODE_NAME"
            else
                json_header
                printf '{"success":false,"message":"Invalid config"}'
            fi
        fi
        ;;

    nodes/save)
        NODE_NAME=$(extract_json_name)
        if [ -z "$NODE_NAME" ]; then
            json_header
            printf '{"success":false,"message":"Node name required"}'
        elif ! valid_node_name "$NODE_NAME"; then
            json_header
            printf '{"success":false,"message":"Invalid node name"}'
        elif [ ! -f "$CONFIG" ]; then
            json_header
            printf '{"success":false,"message":"No active config to save"}'
        elif [ -f "$NODES_DIR/${NODE_NAME}.json" ]; then
            json_header
            printf '{"success":false,"message":"Node already exists"}'
        else
            cp "$CONFIG" "$NODES_DIR/${NODE_NAME}.json"
            echo "$NODE_NAME" > "$ACTIVE_FILE"
            json_header
            printf '{"success":true,"message":"Node saved","name":"%s"}' "$NODE_NAME"
        fi
        ;;

    nodes/rename)
        NODE_NAME=$(extract_json_name)
        DISPLAY_NAME=$(extract_json_display_name)
        if ! valid_node_name "$NODE_NAME" || [ ! -f "$NODES_DIR/${NODE_NAME}.json" ]; then
            json_header
            printf '{"success":false,"message":"Node not found"}'
        elif [ -z "$DISPLAY_NAME" ] || [ ${#DISPLAY_NAME} -gt 64 ]; then
            json_header
            printf '{"success":false,"message":"Invalid display name"}'
        else
            _escaped=$(json_escape_value "$DISPLAY_NAME")
            _sed_name=$(printf '%s' "$_escaped" | sed 's/[\\&|]/\\&/g')
            _tmp="$NODES_DIR/${NODE_NAME}.json.tmp.$$"
            if grep -q '"node_name"[[:space:]]*:' "$NODES_DIR/${NODE_NAME}.json"; then
                sed "s|\"node_name\"[[:space:]]*:[[:space:]]*\"[^\"]*\"|\"node_name\": \"$_sed_name\"|" "$NODES_DIR/${NODE_NAME}.json" > "$_tmp"
            else
                sed "0,/{/s||{\n    \"node_name\": \"$_sed_name\",|" "$NODES_DIR/${NODE_NAME}.json" > "$_tmp"
            fi
            if mv -f "$_tmp" "$NODES_DIR/${NODE_NAME}.json"; then
                [ "$NODE_NAME" = "$(get_active_node)" ] && cp "$NODES_DIR/${NODE_NAME}.json" "$CONFIG"
                json_header
                printf '{"success":true,"name":"%s","display_name":"%s"}' "$NODE_NAME" "$_escaped"
            else
                rm -f "$_tmp"
                json_header
                printf '{"success":false,"message":"Rename failed"}'
            fi
        fi
        ;;

    nodes/switch)
        NODE_NAME=$(extract_json_name)
        if [ -z "$NODE_NAME" ]; then
            json_header
            printf '{"success":false,"message":"Node name required"}'
        elif ! valid_node_name "$NODE_NAME"; then
            json_header
            printf '{"success":false,"message":"Invalid node name"}'
        elif [ ! -f "$NODES_DIR/${NODE_NAME}.json" ]; then
            json_header
            printf '{"success":false,"message":"Node not found"}'
        else
            cp "$NODES_DIR/${NODE_NAME}.json" "$CONFIG"
            echo "$NODE_NAME" > "$ACTIVE_FILE"
            json_header
            printf '{"success":true,"message":"Switched to node","name":"%s"}' "$NODE_NAME"
        fi
        ;;

    nodes/delete)
        NODE_NAME=$(extract_json_name)
        ACTIVE_NODE=$(get_active_node)
        if [ -z "$NODE_NAME" ]; then
            json_header
            printf '{"success":false,"message":"Node name required"}'
        elif ! valid_node_name "$NODE_NAME"; then
            json_header
            printf '{"success":false,"message":"Invalid node name"}'
        elif [ "$NODE_NAME" = "$ACTIVE_NODE" ]; then
            json_header
            printf '{"success":false,"message":"Cannot delete active node"}'
        elif [ ! -f "$NODES_DIR/${NODE_NAME}.json" ]; then
            json_header
            printf '{"success":false,"message":"Node not found"}'
        else
            rm -f "$NODES_DIR/${NODE_NAME}.json"
            json_header
            printf '{"success":true,"message":"Node deleted","name":"%s"}' "$NODE_NAME"
        fi
        ;;

    start)
        ACTION_OUTPUT=$(sh "$MODDIR/scripts/start.sh" "$MODDIR" 2>&1)
        sleep 1
        json_header
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            printf '{"success":true,"message":"gost started (PID: %s)"}' "$(cat "$PIDFILE")"
        else
            [ -z "$ACTION_OUTPUT" ] && ACTION_OUTPUT="gost failed to start"
            printf '{"success":false,"message":"%s"}' "$(json_escape_value "$ACTION_OUTPUT")"
        fi
        ;;

    stop)
        sh "$MODDIR/scripts/stop.sh" "$MODDIR" >/dev/null 2>&1
        sleep 1
        json_header
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            printf '{"success":false,"message":"gost failed to stop"}'
        else
            printf '{"success":true,"message":"gost stopped"}'
        fi
        ;;

    restart)
        sh "$MODDIR/scripts/stop.sh" "$MODDIR" >/dev/null 2>&1
        sleep 1
        ACTION_OUTPUT=$(sh "$MODDIR/scripts/start.sh" "$MODDIR" 2>&1)
        sleep 1
        json_header
        if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
            printf '{"success":true,"message":"gost restarted (PID: %s)"}' "$(cat "$PIDFILE")"
        else
            [ -z "$ACTION_OUTPUT" ] && ACTION_OUTPUT="gost failed to restart"
            printf '{"success":false,"message":"%s"}' "$(json_escape_value "$ACTION_OUTPUT")"
        fi
        ;;

    gost/download)
        DOWNLOAD_SCRIPT="$MODDIR/scripts/download_gost.sh"
        DOWNLOAD_LOCK="/tmp/gost-download.lock"
        DOWNLOAD_LOG="$MODDIR/logs/gost-download.log"
        PERSIST_DIR="/data/adb/gost_proxy"
        json_header
        if [ "$REQUEST_METHOD" != "POST" ]; then
            printf '{"success":false,"message":"POST required"}'
        elif ensure_gost_binary; then
            printf '{"success":false,"message":"Gost binary is already installed"}'
        elif [ -d "$DOWNLOAD_LOCK" ]; then
            printf '{"success":false,"message":"Download already in progress"}'
        elif [ ! -f "$DOWNLOAD_SCRIPT" ]; then
            printf '{"success":false,"message":"download_gost.sh not found"}'
        else
            mkdir "$DOWNLOAD_LOCK" 2>/dev/null || {
                printf '{"success":false,"message":"Download already in progress"}'
                exit 0
            }
            chmod 755 "$DOWNLOAD_SCRIPT" 2>/dev/null
            mkdir -p "$MODDIR/logs"
            (
                sh "$DOWNLOAD_SCRIPT" "$MODDIR/gost" >"$DOWNLOAD_LOG" 2>&1
                _result=$?
                if [ "$_result" -eq 0 ] && [ -s "$MODDIR/gost/gost" ]; then
                    chmod 755 "$MODDIR/gost/gost" 2>/dev/null
                    atomic_copy "$MODDIR/gost/gost" "$PERSIST_DIR/gost" 2>/dev/null
                fi
                rm -rf "$DOWNLOAD_LOCK"
            ) >/dev/null 2>&1 &
            printf '{"success":true,"message":"Gost download started"}'
        fi
        ;;

    logs)
        case "$LINES" in
            ''|*[!0-9]*) LINES=200 ;;
        esac
        [ "$LINES" -gt 1000 ] 2>/dev/null && LINES=1000
        [ "$LINES" -lt 1 ] 2>/dev/null && LINES=1
        if [ -f "$LOG_PATH" ]; then
            LOGS=$(tail -n "$LINES" "$LOG_PATH" 2>/dev/null)
        else
            LOGS="No logs available."
        fi
        LOGS_ESCAPED=$(printf '%s' "$LOGS" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk '{printf "%s\\n", $0}')
        json_header
        printf '{"logs":"%s"}' "$LOGS_ESCAPED"
        ;;

    test)
        TEST_SCRIPT="$MODDIR/scripts/test_proxy.sh"
        json_header
        if [ -f "$TEST_SCRIPT" ]; then
            sh "$TEST_SCRIPT" "$MODDIR"
        else
            printf '{"success":false,"stage":"setup","message":"Proxy test script not found"}'
        fi
        ;;

    command)
        PT=$(normalize_proxy_type "$(jval proxy_type)")
        case "$PT" in
            redirect) LISTEN_SCHEME="red" ;;
            socks5) LISTEN_SCHEME="socks5" ;;
            *) PT="redirect"; LISTEN_SCHEME="red" ;;
        esac
        LA=$(jval listen_addr); [ -z "$LA" ] && LA="0.0.0.0"
        LP=$(jval listen_port); [ -z "$LP" ] && LP="1080"
        # Check if geodata config file mode would be used
        GEODATA_EN=$(jsection_val geodata enabled)
        UP_EN=$(jsection_val upstream enabled)
        if [ "$GEODATA_EN" = "true" ] && [ -f "$MODDIR/gost/geodata/direct-rules.txt" ] && [ "$UP_EN" = "true" ]; then
            CMD="gost -C $MODDIR/gost/runtime.json (geodata bypass: file-based, 70k+ rules)"
            CMD_ESCAPED=$(printf '%s' "$CMD" | sed 's/\\/\\\\/g; s/"/\\"/g')
            json_header
            printf '{"command":"%s"}' "$CMD_ESCAPED"
        else
            # Build full command preview (command-line mode)
            CMD="-L ${LISTEN_SCHEME}://${LA}:${LP}"
            if [ "$UP_EN" = "true" ]; then
                UP_TYPE=$(jsection_val upstream type); [ -z "$UP_TYPE" ] && UP_TYPE="http"
                UP_ADDR=$(jsection_val upstream addr)
                UP_PORT=$(jsection_val upstream port)
                UP_USER=$(jsection_val upstream username)
                UP_AUTH=""
                if [ -n "$UP_USER" ]; then
                    UP_AUTH="${UP_USER}:***@"
                fi
                UP_SCHEME="$UP_TYPE"
                case "$UP_TYPE" in
                    *+ws*|*+wss*) ;;
                    *)
                        UP_WS=$(jsection_val upstream ws_path)
                        [ -n "$UP_WS" ] && UP_SCHEME="${UP_SCHEME}+ws"
                        ;;
                esac
                CMD="${CMD} -F ${UP_SCHEME}://${UP_AUTH}${UP_ADDR}:${UP_PORT}"
                UP_WS=$(jsection_val upstream ws_path)
                CMD="${CMD}?resolver=223.5.5.5%2C1.1.1.1"
                if [ -n "$UP_WS" ]; then
                    CMD="${CMD}&path=${UP_WS}"
                fi
                UP_WS_HOST=$(jsection_val upstream ws_host)
                [ -n "$UP_WS_HOST" ] && CMD="${CMD}&host=${UP_WS_HOST}"
                case "$UP_TYPE" in
                    socks|socks5|socks+ws|socks+wss|socks5+ws|socks5+wss)
                        CMD="${CMD}&notls=true"
                        ;;
                esac
            fi
            CMD_ESCAPED=$(printf '%s' "$CMD" | sed 's/\\/\\\\/g; s/"/\\"/g')
            json_header
            printf '{"command":"%s"}' "$CMD_ESCAPED"
        fi
        ;;

    geodata/status)
        GEODATA_DIR="$MODDIR/gost/geodata"
        STATUS_FILE="$GEODATA_DIR/status.json"
        UPDATING=0
        ls -d "$GEODATA_DIR"/.update.* >/dev/null 2>&1 && UPDATING=1
        json_header
        if [ "$UPDATING" = "1" ]; then
            if [ -f "$STATUS_FILE" ]; then
                EXISTING=$(cat "$STATUS_FILE" 2>/dev/null)
                printf '%s' "$EXISTING" | sed 's/}/,"updating":true}/'
            else
                printf '{"success":false,"updating":true,"message":"Update in progress"}'
            fi
        elif [ -f "$STATUS_FILE" ]; then
            cat "$STATUS_FILE"
        else
            printf '{"success":false,"updating":false,"message":"No geodata downloaded yet"}'
        fi
        ;;

    geodata/update)
        GEODATA_DIR="$MODDIR/gost/geodata"
        UPDATE_SCRIPT="$MODDIR/scripts/update_geodata.sh"
        json_header
        if ls -d "$GEODATA_DIR"/.update.* >/dev/null 2>&1; then
            printf '{"success":false,"message":"Update already in progress"}'
        elif [ ! -f "$UPDATE_SCRIPT" ]; then
            printf '{"success":false,"message":"update_geodata.sh not found"}'
        else
            chmod 755 "$UPDATE_SCRIPT" 2>/dev/null
            sh "$UPDATE_SCRIPT" "$MODDIR" >"$MODDIR/logs/geodata-update.log" 2>&1 &
            printf '{"success":true,"message":"Update started"}'
        fi
        ;;

    config/import)
        if write_config "$BODY"; then
            sync_active_node
            json_header
            printf '{"success":true,"message":"Config imported"}'
        else
            json_header
            printf '{"success":false,"message":"Invalid config"}'
        fi
        ;;

    "")
        json_header
        printf '{"error":"No endpoint specified"}'
        ;;

    *)
        json_header
        printf '{"error":"Unknown endpoint: %s"}' "$ENDPOINT"
        ;;
esac

exit 0
